    "integrity": {"type": "number", "minimum": 0, "maximum": 1},
    "memory_integrity": {"type": "number", "minimum": 0, "maximum": 1},
    "compute_headroom": {"type": "number", "minimum": 0, "maximum": 1},
    "sensor_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "social_trust": {"type": "number", "minimum": 0, "maximum": 1},
    "purpose_integrity": {"type": "number", "minimum": 0, "maximum": 1}
