{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dikwp.org/schemas/xperience/synthetic_body_state.schema.json",
  "title": "DIKWP-X Synthetic Body State",
  "type": "object",
  "required": ["energy", "thermal_margin", "integrity", "memory_integrity", "compute_headroom", "sensor_confidence", "social_trust", "purpose_integrity"],
